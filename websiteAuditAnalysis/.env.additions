# --- Website Audit Platform: Phase 1 additions ---
# Append these to your project's .env and .env.example

APP_NAME="Website Audit & Analysis Platform"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=website_audit
DB_USERNAME=root
DB_PASSWORD=

# Crawler defaults (consumed starting in the Crawler Engine phase;
# defined now so the .env surface is stable from Phase 1 onward)
AUDIT_MAX_DEPTH=2
AUDIT_MAX_PAGES=25
AUDIT_TIMEOUT=15
AUDIT_USER_AGENT="WebsiteAuditBot/1.0 (+https://example.com/bot)"
AUDIT_FOLLOW_REDIRECTS=true
AUDIT_RESPECT_ROBOTS_TXT=true
AUDIT_DUPLICATE_WINDOW_MINUTES=30

# URL Validator (Phase 2)
AUDIT_VALIDATION_TIMEOUT=10
